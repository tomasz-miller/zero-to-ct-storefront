# commercetools Composable Commerce — copy to .env.local
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_SESSION_URL=https://session.europe-west1.gcp.commercetools.com
# Space-separated scopes — storefront BFF needs manage_orders + manage_sessions for cart/checkout.
# manage_payments and view_shipping_methods are required only for CTP_MOCK_PAYMENTS.
# Scopes cannot be changed after an API client is created.
CTP_SCOPES=manage_orders:your-project-key manage_sessions:your-project-key manage_payments:your-project-key view_shipping_methods:your-project-key manage_customers:your-project-key manage_my_profile:your-project-key manage_my_orders:your-project-key manage_shopping_lists:your-project-key view_published_products:your-project-key view_categories:your-project-key create_anonymous_token:your-project-key

# Optional override; defaults map country → demo app keys (see docs/CHECKOUT.md)
# CTP_CHECKOUT_APPLICATION_KEY=demo-commercetools-checkout-taxes

# When true, /checkout skips commercetools Checkout and Stripe. The BFF waits 2s,
# then creates an Order with a successful mock Charge. Leave unset for Stripe.
# CTP_MOCK_PAYMENTS=true

# Public (Checkout Browser SDK + storefront defaults)
NEXT_PUBLIC_CTP_PROJECT_KEY=
NEXT_PUBLIC_CTP_REGION=europe-west1.gcp
NEXT_PUBLIC_DEFAULT_LOCALE=en-GB
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_COUNTRY=DE

# Store branding (header, document title)
NEXT_PUBLIC_STORE_NAME=Zero to CT storefront
NEXT_PUBLIC_STORE_NAME_EMPHASIS=CT
