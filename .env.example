# commercetools Composable Commerce — copy to .env.local
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_SESSION_URL=https://session.europe-west1.gcp.commercetools.com
# Space-separated scopes. Scopes cannot be changed after an API client is created.
# manage_orders            carts (lib/commercetools/cart.ts), order creation and lookup (mock-payment.ts, order-confirmation.ts)
# manage_sessions          Checkout sessions (checkout-session.ts via access-token.ts)
# manage_customers         POST /login, sign-up, password reset (customer-auth.ts)
# manage_shopping_lists    wishlist (shopping-lists.ts)
# view_published_products  catalog, Product Search, suggestions (products.ts, search-suggestions.ts)
# view_categories          navigation (categories.ts)
# manage_my_profile, manage_my_orders  must exist on the client so customer tokens can request them (CTP_CUSTOMER_SCOPES)
# manage_payments, view_shipping_methods  only with CTP_MOCK_PAYMENTS=true and CTP_MOCK_PAYMENTS_PROJECT_KEY=<CTP_PROJECT_KEY>
# UNVERIFIED: which scope covers apiRoot.productTypes() reads (product-types.ts); the list is kept unchanged for it.
CTP_SCOPES=manage_orders:your-project-key manage_sessions:your-project-key manage_customers:your-project-key manage_shopping_lists:your-project-key view_published_products:your-project-key view_categories:your-project-key manage_my_profile:your-project-key manage_my_orders:your-project-key manage_payments:your-project-key view_shipping_methods:your-project-key
# Customer password-flow token scopes; {pk} is replaced by CTP_PROJECT_KEY.
# CTP_CUSTOMER_SCOPES=manage_my_profile:{pk} manage_my_orders:{pk}

# 32+ random bytes, base64. Seals every ct_* cookie (AES-256-GCM). Generate: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated https URL patterns that next/image may fetch (read in next.config.ts).
# Each needs a literal host and at least one literal path segment, e.g. https://cdn.example.com/bucket/**
# Wildcard hosts such as **.amazonaws.com are rejected and fail `next build`.
# Default: https://storage.googleapis.com/merchant-center-europe/sample-data/**  (UNVERIFIED host/prefix of the commercetools sample data)
# IMAGE_REMOTE_PATTERNS=https://storage.googleapis.com/your-bucket/your-prefix/**

# HEALTH_CHECK_TOKEN=  # ≥32 random chars; enables GET /api/health?check=commercetools

# AUTH_DEV_EXPOSE_RESET_TOKEN=true  # next dev only: returns a reset link in the API response

# Optional override; defaults map country → demo app keys (see docs/CHECKOUT.md)
# CTP_CHECKOUT_APPLICATION_KEY=demo-commercetools-checkout-taxes

# When true, /checkout skips commercetools Checkout and Stripe. The BFF waits 2s,
# then creates an Order with a successful mock Charge. Leave unset for Stripe.
# CTP_MOCK_PAYMENTS=true
# Required next to CTP_MOCK_PAYMENTS=true: must equal CTP_PROJECT_KEY, otherwise mock payments stay
# disabled. Guards against a copied env file enabling mock payments against a real project.
# CTP_MOCK_PAYMENTS_PROJECT_KEY=your-project-key

# Public (Checkout Browser SDK + storefront defaults)
NEXT_PUBLIC_CTP_PROJECT_KEY=
NEXT_PUBLIC_CTP_REGION=europe-west1.gcp
NEXT_PUBLIC_DEFAULT_LOCALE=en-GB
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_COUNTRY=DE

# Store branding (header, document title)
NEXT_PUBLIC_STORE_NAME=Zero to CT storefront
NEXT_PUBLIC_STORE_NAME_EMPHASIS=CT
